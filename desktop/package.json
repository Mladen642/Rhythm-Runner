{
  "name": "rhythm-runner",
  "productName": "Rhythm Runner",
  "version": "0.2.0",
  "description": "A pixel-art rhythm runner: twelve chapters, twelve genres, one groove.",
  "author": "Mladen Babić",
  "homepage": "https://github.com/Mladen642/Rhythm-Runner",
  "repository": { "type": "git", "url": "https://github.com/Mladen642/Rhythm-Runner.git" },
  "license": "GPL-3.0-or-later",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --linux AppImage"
  },
  "build": {
    "appId": "io.github.rhythm-runner",
    "productName": "Rhythm Runner",
    "files": ["main.js", "build/icon.png", { "from": "../game", "to": "web" }],
    "asar": false,
    "directories": { "output": "dist", "buildResources": "build" },
    "linux": {
      "target": ["AppImage"],
      "category": "Game",
      "icon": "build/icon.png",
      "artifactName": "RhythmRunner-${version}-x86_64.AppImage",
      "synopsis": "A twelve-chapter pixel rhythm runner"
    }
  },
  "devDependencies": { "electron": "33.2.1", "electron-builder": "25.1.8" }
}
